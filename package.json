{
  "name": "bullmq-batch",
  "version": "0.0.1",
  "description": "Distributed batching extensions for BullMQ (BatchWorker, BatchQueue).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/copy-lua.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaackogan/BullMq-Batch.git"
  },
  "license": "MIT",
  "author": "isaackogan",
  "peerDependencies": {
    "bullmq": ">=5"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.10.1",
    "tsdown": "^0.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
